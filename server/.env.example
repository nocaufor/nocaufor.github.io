# nocau.com 后端环境变量模板
# 复制为 .env 并按需修改，.env 已被 .gitignore 排除，严禁提交

# 服务端口
PORT=3000

# 站点静态文件根目录（相对 server/ 的上级目录）
STATIC_DIR=..

# 数据库文件路径（相对 server/）
DB_PATH=./data/nocau.db

# 管理接口访问令牌（查看留言列表用，必填，建议 32 位以上随机串）
ADMIN_TOKEN=change-me-to-a-long-random-string

# 联系表单限流（15 分钟内同一 IP 最多提交次数）
CONTACT_RATE_WINDOW_MS=900000
CONTACT_RATE_MAX=5

# 信任代理层数（部署到 Nginx 反代后设为 1）
TRUST_PROXY=0
